{
  "name": "paperweb",
  "version": "1.0.0",
  "description": "PaperPulse - Real-time Academic Paper Observatory for Smart Manufacturing & AI",
  "main": "server/index.ts",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "academic",
    "manufacturing",
    "llm",
    "knowledge-graph",
    "embodied-ai"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "d3-force": "^3.0.1",
    "express": "^5.3.0",
    "lucide-react": "^0.511.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/cors": "^2.8.18",
    "@types/d3-force": "^3.0.10",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
